# Obligatoires sur Render
SECRET_KEY=remplacer-par-une-cle-django-longue-et-aleatoire
DEBUG=False
DATABASE_URL=postgresql://utilisateur:mot_de_passe@hote/base
ALLOWED_HOSTS=pauline1-boutique.onrender.com
CORS_ALLOWED_ORIGINS=https://pauline-boutique1.onrender.com
FRONTEND_URL=https://pauline-boutique1.onrender.com

# Envoi sécurisé des liens de réinitialisation (exemple Gmail avec mot de passe d'application)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=votre-adresse@gmail.com
EMAIL_HOST_PASSWORD=votre-mot-de-passe-application
DEFAULT_FROM_EMAIL=votre-adresse@gmail.com

# Cloudinary si utilisé pour les images
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Compte administrateur du tableau de bord boutique (facultatif, mot de passe >= 12 caractères)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
